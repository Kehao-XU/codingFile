{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: 编译并运行当前文件",
            "detail": "g++ 编译当前打开的 .cpp，输出到 output/，成功后立即运行",
            "type": "shell",
            "command": "chcp 65001 > $null; New-Item -ItemType Directory -Force -Path '${workspaceFolder}/output' | Out-Null; g++ -O2 -std=c++17 -Wall -fexec-charset=utf-8 '${file}' -o '${workspaceFolder}/output/${fileBasenameNoExtension}.exe'; if ($?) { & '${workspaceFolder}/output/${fileBasenameNoExtension}.exe' }",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "C++: 仅编译当前文件",
            "detail": "只编译不运行，用于快速查语法错误",
            "type": "shell",
            "command": "chcp 65001 > $null; New-Item -ItemType Directory -Force -Path '${workspaceFolder}/output' | Out-Null; g++ -O2 -std=c++17 -Wall -fexec-charset=utf-8 '${file}' -o '${workspaceFolder}/output/${fileBasenameNoExtension}.exe'",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}